   1 //! The modeline: one quiet row at the bottom edge.                                                                                    
   2 //!                                                                                                                                    
   3 //! Every width is a display cell, never a character.                                                                                  
   4                                                                                                                                        
   5 use std::path::Path;                                                                                                                   
   6                                                                                                                                        
   7 /// Gather the row.                                                                                                                    
   8 pub struct Modeline {                                                                                                                  
   9 │   chip: String,                                                                                                                      
  10 │   dirty: bool,                                                                                                                       
  11 │   line: usize,                          ╭ recovery draft ───────────────── r7 · 12 B ╮                                               
  12 }                                         │ src/render/statusline.rs                   │                                               
  13                                           │ an earlier session left an unsaved draft   │                                               
  14 impl Modeline {                           │ ▲ the file changed on disk since the draft │                                               
  15 │   fn gather(path: &Path, line: usize) ->│                                            │                                               
  16 │   │   let chip = format!(" {} ", "NORMAL│  r   recover the draft into this buffer    │                                               
  17 │   │   // the filename must survive trunc│  o   open the file read-only               │                                               
  18 │   │   Self { chip, dirty: path.exists(),│  d   delete the draft                      │                                               
  19 │   }                                     │  e   edit the file anyway                  │                                               
  20 }                                         ╰  esc  edit anyway ─────────────────────────╯                                               

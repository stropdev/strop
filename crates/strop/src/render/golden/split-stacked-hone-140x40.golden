  11 │   line: usize,                                                                                                                      ▮
  12 }                                                                                                                                     ▮
  13                                                                                                                                       ▮
  14 impl Modeline {                                                                                                                       ▮
  15 │   fn gather(path: &Path, line: usize) -> Self {                                                                                     ▮
  16 │   │   let chip = format!(" {} ", "NORMAL");                                                                                          
  17 │   │   // the filename must survive truncation                                                                                        
  18 │   │   Self { chip, dirty: path.exists(), line }                                                                                      

   1 //! The modeline: one quiet row at the bottom edge.             │   1 //! The modeline: one quiet row at the bottom edge.              
   2 //!                                                             │   2 //!                                                              
   3 //! Every width is a display cell, never a character.           │   3 //! Every width is a display cell, never a character.            
   4                                                                 │   4                                                                  
   5 use std::path::Path;                                            │   5 use std::path::Path;                                             
   6                                                                 │   6                                                                  
   7 /// Gather the row.                                             │   7 /// Gather the row.                                              
   8 pub struct Modeline {                                           │   8 pub struct Modeline {                                            
   9 │   chip: String,                                               │   9     chip: String,                                                
  10 │   dirty: bool,                                                │  10     dirty: bool,                                                 
  11 │   line: usize,                                                │  11     line: usize,                                                 
  12 }                                                               │  12 }                                                                
  13                                                                 │  13                                                                  
  14 impl Modeline {                                                 │  14 impl Modeline {                                                  
  15 │   fn gather(path: &Path, line: usize) -> Self {               │  15     fn gather(path: &Path, line: usize) -> Self {                
  16 │   │   let chip = format!(" {} ", "NORMAL");                   │  16         let chip = format!(" {} ", "NORMAL");                    
  17 │   │   // the filename must survive truncation                 │  17         // the filename must survive truncation                  
  18 │   │   Self { chip, dirty: path.exists(), line }               │  18         Self { chip, dirty: path.exists(), line }                
  19 │   }                                                           │  19     }                                                            
  20 }                                                               │  20 }                                                                

   1  const LABELS: &[&str] = &["alpha", "beta", "gamma", "delta", "epsilon", "zeta", "eta", "theta", "iota", "kappa", "lambda", "mu", "nu" 
   2  //! The modeline: one quiet row at the bottom edge.                                                                                   
   3  //!                                                                                                                                   
   4  //! Every width is a display cell, never a character.                                                                                 
   5                                                                                                                                        
   6  use std::path::Path;                                                                                                                  
   7                                                                                                                                        
   8  /// Gather the row.                                                                                                                   
   9  pub struct Modeline {                                                                                                                 
  10  │   chip: String,                                                                                                                     
  11  │   dirty: bool,                                                                                                                      
  12  │   line: usize,                                                                                                                      
  13  }                                                                                                                                     
  14                                                                                                                                        
  15  impl Modeline {                                                                                                                       
  16  │   fn gather(path: &Path, line: usize) -> Self {                                                                                     
  17  │   │   let chip = format!(" {} ", "NORMAL");                                                                                         
  18  │   │   // the filename must survive truncation                                                                                       
  19  │   │   Self { chip, dirty: path.exists(), line }                                                                                     
  20  │   }                                                                                                                                 
  21  }                                                                                                                                     

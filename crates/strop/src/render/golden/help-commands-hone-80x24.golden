  ━ Commands ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ 
                                                                                
  ─ Command line ────────────────────────────────────────────────────────────── 
    :                          the command line (from Visual it opens with      
                               '<,'>)                                           
    :N :N,M :. :$ :% :'a :'<,'> :/pat/ :?pat? :.+N :N;+M                        
                               ranges: lines, marks, searches and offsets; :N   
                               alone goes to the line                           
    enter ctrl-j ctrl-m        run the line (a failed line says so in error     
                               ink)                                             
    esc ctrl-[ ctrl-c          cancel; the view returns to where it was         
    backspace ctrl-h           delete before the cursor; on an empty line,      
                               cancel                                           
    delete                     delete under the cursor (at the end: before it)  
    ctrl-w                     delete the word before the cursor               ▮
    ctrl-u                     delete everything before the cursor              
    left                       one character left                               
    right                      one character right                              
    ctrl-b home                start of the line                                
    ctrl-e end                 end of the line; with a completion selected:     
                               put back what was typed                          
    ctrl-r                     insert a register (" a-z 0 : / +); ctrl-r        
                               ctrl-w / ctrl-a: the word / WORD under the       

   1  //! The modeline: one quiet row at the bottom edge.                       
   2                                                                            
   3  /// Gather the row.                                                       
   4  pub struct Modeline {                                                     
   5  │   chip: String,                                                         
   6  │   dirty: bool,                                                          
   7  │   line: usize,                                                          
   8  }                                                                         
   9                                                                            
  10  impl Modeline {                                                           
  11  │   fn gather(path: &Path, line: usize) -> Self {                         
  12  │   │   let chip = format!(" {} ", "NORMAL");                             
  13  │   │   Self { chip, dirty: path.exists(), line }                         
  14  │   }                                                                     

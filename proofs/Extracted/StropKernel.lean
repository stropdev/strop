/-- [strop_kernel::generation::index_for_len]:
    Source: 'crates/strop-kernel/src/generation.rs', lines 21:0-27:1
    Visibility: public -/
def generation.index_for_len (len : Std.Usize) : Result (Option Std.U32) := do
  let i ← lift (UScalar.cast .Usize core.num.U32.MAX)
  if len > i
  then ok none
  else let i1 ← lift (UScalar.cast .U32 len)
       ok (some i1)

end strop_kernel
